respaldos/
herramientas/.credenciales.json
herramientas/credenciales-nuevas.txt

# Variables de entorno. Nunca suba una service_role key: salta las políticas RLS
# y el repositorio es público.
.env
.env.*
*.env
herramientas/.env
!.env.ejemplo

# Dependencias. El sistema se sigue publicando como archivos estáticos: esto es
# solo para las herramientas de línea de comandos (Supabase CLI y, más adelante,
# el empaquetador).
node_modules/

# Temporales del CLI de Supabase. Las migraciones de supabase/migrations/ SÍ se
# versionan: son la fuente de verdad del esquema de todos los clientes.
supabase/.temp/
supabase/.branches/
